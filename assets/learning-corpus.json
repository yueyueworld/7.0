[
  { "id": "lc_0001", "en": "I need help.", "zh": "我需要帮助。" },
  { "id": "lc_0002", "en": "How to get there?", "zh": "怎么去那里？" },
  { "id": "lc_0003", "en": "Is this the right place?", "zh": "是在这里坐车吗？" },
  { "id": "lc_0004", "en": "Which line goes to Hyde Park?", "zh": "去海德公园要坐哪条线路？" },
  { "id": "lc_0005", "en": "Is this the right platform?", "zh": "这是正确的站台吗？" },
  { "id": "lc_0006", "en": "How much is the ticket?", "zh": "车票多少钱？" },
  { "id": "lc_0007", "en": "Which exit to take?", "zh": "该走哪个出口？" },
  { "id": "lc_0008", "en": "I want some water.", "zh": "我想要点水。" },
  { "id": "lc_0009", "en": "Thank you very much.", "zh": "非常感谢你。" },
  { "id": "lc_0010", "en": "Which exit should I take?", "zh": "我该走哪个出口？" },
  { "id": "lc_0011", "en": "Is there a shop near here?", "zh": "这附近有商店吗？" },
  { "id": "lc_0012", "en": "Have a nice day!", "zh": "祝你过得愉快！" },
  { "id": "lc_0013", "en": "I want to go back.", "zh": "我想要回去。" },
  { "id": "lc_0014", "en": "Can you help me?", "zh": "你能帮帮我吗？" },
  { "id": "lc_0015", "en": "Have a safe trip.", "zh": "祝你一路平安。" },
  { "id": "lc_0016", "en": "I want to go back to my hotel.", "zh": "我想回我的酒店。" },
  { "id": "lc_0017", "en": "It's near King's Cross Station.", "zh": "它在国王十字车站附近。" },
  { "id": "lc_0018", "en": "Thanks for your help!", "zh": "谢谢你的帮助！" },
  { "id": "lc_0019", "en": "Good evening! Welcome to our hotel.", "zh": "晚上好！欢迎来到我们的酒店。" },
  { "id": "lc_0020", "en": "I have a booking.", "zh": "我有预订。" },
  { "id": "lc_0021", "en": "My name is Li Ming.", "zh": "我的名字是李明。" },
  { "id": "lc_0022", "en": "Is that right?", "zh": "对吗？" },
  { "id": "lc_0023", "en": "What time is breakfast?", "zh": "早餐几点供应？" },
  { "id": "lc_0024", "en": "Here is your key.", "zh": "这是你的房卡。" },
  { "id": "lc_0025", "en": "Where is the lift?", "zh": "电梯在哪里？" },
  { "id": "lc_0026", "en": "Good morning! Did you sleep well?", "zh": "早上好！你睡得好吗？" },
  { "id": "lc_0027", "en": "I slept well.", "zh": "我睡得很好。" },
  { "id": "lc_0028", "en": "I want to have breakfast now.", "zh": "我现在想用早餐。" },
  { "id": "lc_0029", "en": "Full English breakfast or something simple?", "zh": "要全英式早餐还是简单点的餐食？" },
  { "id": "lc_0030", "en": "Full English breakfast, please.", "zh": "麻烦给我一份全英式早餐。" },
  { "id": "lc_0031", "en": "And a cup of coffee.", "zh": "再加一杯咖啡。" },
  { "id": "lc_0032", "en": "You can sit anywhere.", "zh": "你可以随便坐。" },
  { "id": "lc_0033", "en": "I'll sit over there.", "zh": "我会坐在那边。" },
  { "id": "lc_0034", "en": "Are you leaving today?", "zh": "你今天要离店吗？" },
  { "id": "lc_0035", "en": "Did you enjoy your stay?", "zh": "你住得还满意吗？" },
  { "id": "lc_0036", "en": "It was great.", "zh": "体验非常好。" },
  { "id": "lc_0037", "en": "I want to pay now.", "zh": "我现在想结账。" },
  { "id": "lc_0038", "en": "Here is your bill.", "zh": "这是你的账单。" },
  { "id": "lc_0039", "en": "Card or cash?", "zh": "刷卡还是付现金？" },
  { "id": "lc_0040", "en": "By card, please.", "zh": "麻烦刷卡支付。" },
  { "id": "lc_0041", "en": "All done!", "zh": "办理完成啦！" },
  { "id": "lc_0042", "en": "Come back again soon!", "zh": "欢迎下次再来！" },
  { "id": "lc_0043", "en": "Thank you for everything.", "zh": "谢谢你所做的一切。" },
  { "id": "lc_0044", "en": "Good afternoon! Do you have a booking?", "zh": "下午好！你有预订吗？" },
  { "id": "lc_0045", "en": "Is there a table for one?", "zh": "有单人位吗？" },
  { "id": "lc_0046", "en": "This way please.", "zh": "这边请。" },
  { "id": "lc_0047", "en": "Would you like to see the menu?", "zh": "你需要看一下菜单吗？" },
  { "id": "lc_0048", "en": "I want the classic afternoon tea, please.", "zh": "麻烦给我一份经典英式下午茶。" },
  { "id": "lc_0049", "en": "Tea or coffee with it?", "zh": "需要配茶还是咖啡？" },
  { "id": "lc_0050", "en": "Tea with milk, please.", "zh": "麻烦给我加奶的红茶。" },
  { "id": "lc_0051", "en": "Here is your tea and food.", "zh": "这是你的茶和餐点。" },
  { "id": "lc_0052", "en": "Enjoy!", "zh": "请慢用！" },
  { "id": "lc_0053", "en": "What should I eat first?", "zh": "我应该先吃什么？" },
  { "id": "lc_0054", "en": "First sandwiches, then scones, then sweets.", "zh": "先吃三明治，然后是司康饼，最后是甜点。" },
  { "id": "lc_0055", "en": "How do I eat the scone?", "zh": "司康饼要怎么吃？" },
  { "id": "lc_0056", "en": "Cut it open, add cream first, then jam.", "zh": "把它切开，先加奶油，再加果酱。" },
  { "id": "lc_0057", "en": "That's British style!", "zh": "这是英式吃法！" },
  { "id": "lc_0058", "en": "That's fun!", "zh": "这太有趣了！" },
  { "id": "lc_0059", "en": "I'll try it.", "zh": "我会试试看的。" },
  { "id": "lc_0060", "en": "Did you enjoy your afternoon tea?", "zh": "你喜欢你的下午茶吗？" },
  { "id": "lc_0061", "en": "I loved it!", "zh": "我太喜欢了！" },
  { "id": "lc_0062", "en": "Can I have another cup of tea?", "zh": "我能再要一杯茶吗？" },
  { "id": "lc_0063", "en": "More hot water and milk too?", "zh": "还要加热水和牛奶吗？" },
  { "id": "lc_0064", "en": "Yes, please.", "zh": "好的，麻烦了。" },
  { "id": "lc_0065", "en": "Here is your bill.", "zh": "这是你的账单。" },
  { "id": "lc_0066", "en": "Have a nice day!", "zh": "祝你过得愉快！" },
  { "id": "lc_0067", "en": "Here is the money.", "zh": "给你钱。" },
  { "id": "lc_0068", "en": "Hello! Welcome to the British Museum.", "zh": "你好！欢迎来到大英博物馆。" },
  { "id": "lc_0069", "en": "First time here?", "zh": "是第一次来吗？" },
  { "id": "lc_0070", "en": "I want to see the most famous things first.", "zh": "我想先看最有名的展品。" },
  { "id": "lc_0071", "en": "Then you must see the Rosetta Stone!", "zh": "那你一定要看罗塞塔石碑！" },
  { "id": "lc_0072", "en": "It's in the Egyptian room.", "zh": "它在埃及展厅。" },
  { "id": "lc_0073", "en": "Where is the Egyptian room?", "zh": "埃及展厅在哪里？" },
  { "id": "lc_0074", "en": "Go straight, turn left.", "zh": "直走，然后左转。" },
  { "id": "lc_0075", "en": "You'll see the sign.", "zh": "你会看到指示牌。" },
  { "id": "lc_0076", "en": "It's free!", "zh": "这里是免费开放的！" },
  { "id": "lc_0077", "en": "I'll go there now.", "zh": "我现在就过去。" },
  { "id": "lc_0078", "en": "Did you find the Rosetta Stone?", "zh": "你找到罗塞塔石碑了吗？" },
  { "id": "lc_0079", "en": "It's amazing, right?", "zh": "它很震撼，对吗？" },
  { "id": "lc_0080", "en": "It's amazing!", "zh": "它太震撼了！" },
  { "id": "lc_0081", "en": "Why is it so important?", "zh": "它为什么这么重要？" },
  { "id": "lc_0082", "en": "Because it helped us read ancient Egyptian writing!", "zh": "因为它帮我们读懂了古埃及的文字！" },
  { "id": "lc_0083", "en": "What else should I see?", "zh": "我还应该看些什么？" },
  { "id": "lc_0084", "en": "You can also see the Parthenon Marbles.", "zh": "你还可以去看帕特农神庙雕塑。" },
  { "id": "lc_0085", "en": "They're in the Greek room.", "zh": "它们在希腊展厅。" },
  { "id": "lc_0086", "en": "I'll go there next.", "zh": "我接下来就去那里。" },
  { "id": "lc_0087", "en": "How was your visit?", "zh": "你的参观体验怎么样？" },
  { "id": "lc_0088", "en": "Did you see everything you wanted?", "zh": "你看到所有想看的东西了吗？" },
  { "id": "lc_0089", "en": "It was great!", "zh": "体验太棒了！" },
  { "id": "lc_0090", "en": "I bought some gifts too.", "zh": "我还买了一些纪念品。" },
  { "id": "lc_0091", "en": "The gift shop has many good things.", "zh": "礼品店有很多不错的东西。" },
  { "id": "lc_0092", "en": "Will you come back?", "zh": "你还会再来吗？" },
  { "id": "lc_0093", "en": "Yes, I hope to come back again.", "zh": "会的，我希望能再来一次。" },
  { "id": "lc_0094", "en": "We'll be here!", "zh": "我们一直都在！" },
  { "id": "lc_0095", "en": "Have fun in London!", "zh": "祝你在伦敦玩得开心！" }
]
